{
  "name": "screenscope",
  "version": "1.0.1",
  "description": "Real-time vectorscope and waveform monitor using screen capture",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "build": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:win": "vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.screenscope.app",
    "productName": "ScreenScope",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "src/main/**",
      "src/worker/**",
      "assets/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    }
  }
}
